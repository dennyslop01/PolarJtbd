@typeparam TItem

<div class="enterprise-datagrid-wrapper">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                @ChildContentHeader
            </thead>
            <tbody>
                @foreach (var item in PaginatedData)
                {
                    @ChildContentRow(item)
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-controls">
        <div class="pagination-page-size">
            <span class="text-muted">Mostrando <strong>@StartRecord</strong> a <strong>@EndRecord</strong> de <strong>@TotalCount</strong></span>
            <span class="mx-2 text-muted">•</span>
            <label for="pageSize" class="mb-0 text-muted">Filas:</label>
            <select @bind="PageSize" id="pageSize" class="form-select form-select-sm d-inline-block w-auto">
                @foreach (var size in PageSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>

        <div class="pagination-buttons-group">
            <button @onclick="PreviousPage" disabled="@IsPreviousDisabled" title="Página Anterior">
                <i class="bi bi-chevron-left"></i>
            </button>

            @foreach (var pageNumber in GetVisiblePageNumbers())
            {
                <button @onclick="() => GoToPage(pageNumber)" class="@(CurrentPage == pageNumber ? "active" : "")">
                    @pageNumber
                </button>
            }

            <button @onclick="NextPage" disabled="@IsNextDisabled" title="Página Siguiente">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();
    [Parameter] public int DefaultPageSize { get; set; } = 10;
    [Parameter] public RenderFragment? ChildContentHeader { get; set; }
    [Parameter] public RenderFragment<TItem> ChildContentRow { get; set; } = null!;

    private int PageSize { get; set; }
    private int CurrentPage { get; set; } = 1;

    private readonly int[] PageSizes = new[] { 5, 10, 20, 50 };

    private int TotalCount => Items?.Count() ?? 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
    private int StartRecord => TotalCount == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int EndRecord => Math.Min(CurrentPage * PageSize, TotalCount);

    private List<TItem> PaginatedData => (Items ?? Enumerable.Empty<TItem>())
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    protected override void OnInitialized()
    {
        PageSize = DefaultPageSize;
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }

    private void GoToPage(int pageNumber)
    {
        CurrentPage = Math.Clamp(pageNumber, 1, TotalPages);
    }

    private bool IsPreviousDisabled => CurrentPage <= 1;
    private bool IsNextDisabled => CurrentPage >= TotalPages;

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        int start = Math.Max(1, CurrentPage - 2);
        int end = Math.Min(TotalPages, start + 4);
        if (end - start < 4)
        {
            start = Math.Max(1, end - 4);
        }
        return Enumerable.Range(start, end - start + 1);
    }
}
