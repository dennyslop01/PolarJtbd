@page "/proyect/proyectos/{userrol}"

@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject IConfiguration configuration
@inject ILogger<Proyectos> Logger
@inject AuthenticationStateProvider authenticationStateProvider

<PageTitle>Proyectos | Sales Clusters</PageTitle>

<!-- Ward Clustering Methodology Hero Banner -->
<div class="ward-banner">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <div class="ward-banner-title">
            <i class="bi bi-diagram-3-fill"></i>
            <span>Segmentación de Clientes y Mercados • Método de Ward</span>
        </div>
        <span class="ward-tag-pill">
            <i class="bi bi-calculator"></i> Varianza Mínima
        </span>
    </div>
    <p class="ward-banner-desc">
        Técnica de análisis de conglomerados (clustering jerárquico) aplicada a la gestión comercial y mercadeo de
        Empresas Polar. Minimiza la varianza interna entre grupos para clasificar de manera matemática y objetiva las
        motivaciones y fuerzas de decisión de compra (Jobs to be Done).
    </p>
</div>

<!-- Executive KPIs -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon-wrap kpi-icon-blue">
            <i class="bi bi-folder2"></i>
        </div>
        <div class="kpi-content">
            <span class="kpi-label">Proyectos Totales</span>
            <span class="kpi-value">@(proyectos?.Count ?? 0)</span>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-wrap kpi-icon-green">
            <i class="bi bi-check2-circle"></i>
        </div>
        <div class="kpi-content">
            <span class="kpi-label">Proyectos Activos</span>
            <span class="kpi-value">@(proyectos?.Count(p => p.StatusProject == 1) ?? 0)</span>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-wrap kpi-icon-purple">
            <i class="bi bi-pie-chart-fill"></i>
        </div>
        <div class="kpi-content">
            <span class="kpi-label">Proyectos Concluidos</span>
            <span class="kpi-value">@(proyectos?.Count(p => p.StatusProject == 2) ?? 0)</span>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-wrap kpi-icon-amber">
            <i class="bi bi-cpu"></i>
        </div>
        <div class="kpi-content">
            <span class="kpi-label">Algoritmo de Agrupación</span>
            <span class="kpi-value" style="font-size: 1.05rem; padding-top: 4px;">Ward Hierarchical</span>
        </div>
    </div>
</div>

@if (mostrarAlerta)
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container shadow" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}

<div class="card-enterprise">
    <div class="card-enterprise-header flex-wrap gap-3">
        <div>
            <h4 class="card-enterprise-title">
                <i class="bi bi-collection-fill"></i> Gestión de Proyectos de Segmentación
            </h4>
            <span class="text-muted small">Iniciativas estratégicas de investigación cuantitativa y cualitativa
                JTBD</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Buscar proyecto o área..."
                           @bind="busqueda" @bind:event="oninput" />
                </div>
                @if (UserRol > 0 && UserRol < 3)
                {
                    <button class="btn boton-primario" @onclick="MostrarFormulario" title="Agregar Proyecto">
                        <i class="bi bi-plus-lg"></i> Nuevo Proyecto
                    </button>
                }
            </div>
        </div>

        @if (proyectos is null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Cargando portafolio de proyectos...</p>
            </div>
        }
        else if (!proyectosFiltrados.Any())
        {
            <div class="text-center py-5 border rounded bg-light">
                <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                <p class="text-muted mt-2 mb-0">No se encontraron proyectos @(string.IsNullOrWhiteSpace(busqueda) ?
                     "disponibles" : $"que coincidan con '{busqueda}'").</p>
                </div>
            }
    else
            {
                <PaginationComponentEdit TItem="Projects" Items="proyectosFiltrados" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr>
                            <th width="4%">#</th>
                            <th width="32%">Iniciativa / Proyecto</th>
                            <th width="12%">Fecha</th>
                            <th width="14%">Departamento</th>
                            <th width="14%">Categoría</th>
                            <th width="10%">Estatus</th>
                            <th width="14%" class="text-end">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr>
                            <td class="text-muted fw-bold">@BuscarIndex(p.IdProject)</td>
                            <td>
                                <div class="fw-bold text-dark">@p.ProjectName</div>
                                @if (!string.IsNullOrWhiteSpace(p.ProjectDescription))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 320px;" title="@p.ProjectDescription">
                                        @p.ProjectDescription</div>
                                    }
                                </td>
                                <td>
                                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                                    <span>@(p.ProjectDate.ToString("yyyy-MM-dd"))</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-building me-1 text-secondary"></i>@(p.Deparment?.Name ?? "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border">
                                        <i class="bi bi-tag me-1 text-primary"></i>@(p.Categories?.Name ?? "-")
                                    </span>
                                </td>
                                <td>
                                    @if (p.StatusProject == 1)
                                    {
                                        <span class="badge-enterprise badge-active">
                                            <i class="bi bi-record-fill" style="font-size: 0.6rem;"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-enterprise badge-closed">
                                            <i class="bi bi-lock-fill" style="font-size: 0.6rem;"></i> Concluido
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn boton-secundario text-dark btn-fijo" title="Gestionar Entrevistados"
                                                @onclick="() => AgrgarEntrvistado(p.IdProject.ToString())">
                                            <i class="bi bi-people"></i>
                                        </button>
                                        <button class="btn boton-secundario text-dark btn-fijo" title="Agrupar Fuerzas e Historias"
                                                @onclick="() => AgruparHistorias(p.IdProject.ToString())">
                                            <i class="bi bi-ui-checks-grid"></i>
                                        </button>
                                        <button class="btn boton-secundario text-primary btn-fijo" title="Matriz y Clustering de Ward"
                                                @onclick="() => MostrarMatriz(p.IdProject.ToString())">
                                            <i class="bi bi-diagram-3"></i>
                                        </button>
                                        @if (UserRol > 0 && UserRol < 3)
                                        {
                                            @if (p.StatusProject == 1)
                                            {
                                                <button class="btn boton-secundario btn-fijo" title="Editar Proyecto"
                                                        @onclick="() => EditarEntidad(p)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn boton-secundario btn-fijo" title="Ver Proyecto"
                                                        @onclick="() => EditarEntidad(p)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            }

                                            <button class="btn btn-enterprise-danger btn-fijo" title="Eliminar Proyecto"
                                                    @onclick="() => EliminarEntidad(p.IdProject)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        </ChildContentRow>
                    </PaginationComponentEdit>
                }
            </div>

            @if (mostrarFormulario)
            {
                <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">@(proyectoActual.IdProject == 0 ? "Agregar" : "Editar")</h5>
                                <button type="button" class="btn-close" @onclick="Cancelar"></button>
                            </div>
                            <div class="modal-body">
                                <EditForm Model="@proyectoActual" OnValidSubmit="GuardarEntidad">
                                    <DataAnnotationsValidator />

                                    <div class="mb-3">
                                        <label class="form-label">Nombre:</label>
                                        <InputText class="form-control" @bind-Value="proyectoActual.ProjectName"
                                                   disabled="@(proyectoActual.StatusProject != 1)" />
                                        <ValidationMessage For="@(() => proyectoActual.ProjectName)" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Fecha:</label>
                                        <InputDate class="form-control" @bind-Value="proyectoActual.ProjectDate"
                                                   disabled="@(proyectoActual.StatusProject != 1)" />
                                        <ValidationMessage For="@(() => proyectoActual.ProjectDate)" />
                                    </div>
                                    @if (UserRol == 1)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label">Departamentos:</label>
                                            <InputSelect class="form-select" @bind-Value="proyectoActual.IdDeparmento"
                                                         disabled="@(proyectoActual.StatusProject != 1)">
                                                <option value="-1">-- Seleccione uno --</option>
                                                @foreach (var item in departamento)
                                                {
                                                    <option value="@item.Id">@item.Name</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => proyectoActual.IdDeparmento)" />
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label class="form-label">Categorías:</label>
                                        <InputSelect class="form-select" @bind-Value="proyectoActual.idCategoria"
                                                     disabled="@(proyectoActual.StatusProject != 1)">
                                            <option value="-1">-- Seleccione uno --</option>
                                            @foreach (var item in categorias)
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => proyectoActual.idCategoria)" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Descripcion:</label>
                                        <InputText class="form-control" @bind-Value="proyectoActual.ProjectDescription"
                                                   disabled="@(proyectoActual.StatusProject != 1)" />
                                        <ValidationMessage For="@(() => proyectoActual.ProjectDescription)" />
                                    </div>
                                    <div class="d-flex justify-content-end">
                                        @if (proyectoActual.StatusProject != 2)
                                        {
                                            <button type="submit" class="btn boton-primario me-2">
                                                <i class="bi bi-save"></i> Guardar
                                            </button>
                                        }
                                        <button type="button" class="btn btn-danger" @onclick="Cancelar">
                                            <i class="bi bi-times"></i> Cancelar
                                        </button>
                                    </div>
                                </EditForm>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (mostrarFormulario2)
            {
                <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Abrir Proyecto</h5>
                                <button type="button" class="btn-close" @onclick="Cancelar"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-warning" role="alert">
                                    ¿Está seguro? Desea volver abrir el proyecto.
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="button" class="btn boton-primario me-2" @onclick="CerrarProyecto">
                                        <i class="bi bi-times"></i> Abrir
                                    </button>
                                    <button type="button" class="btn btn-danger" @onclick="Cancelar">
                                        <i class="bi bi-times"></i> Cancelar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (cargando)
            {
                <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="modal-cargando text-lg-center">
                                    <div class="spinner-border" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }


@code {
    [Parameter]
    public string userrol { get; set; }

    private List<Deparments> departamento = new();
    private List<Categories> categorias = new();
    private List<Projects> proyectos = new();
    private string busqueda = "";
    private IEnumerable<Projects> proyectosFiltrados =>
        string.IsNullOrWhiteSpace(busqueda)
            ? proyectos
            : proyectos.Where(p =>
                (!string.IsNullOrEmpty(p.ProjectName) && p.ProjectName.Contains(busqueda, StringComparison.OrdinalIgnoreCase)) ||
                (p.Deparment?.Name != null && p.Deparment.Name.Contains(busqueda, StringComparison.OrdinalIgnoreCase)) ||
                (p.Categories?.Name != null && p.Categories.Name.Contains(busqueda, StringComparison.OrdinalIgnoreCase)));
    private CreateProject proyectoActual = new();
    private bool mostrarFormulario = false;
    private bool mostrarFormulario2 = false;
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;
    private string username = "dusa-user";
    private int UserRol = 5;
    private string usernamelargo = string.Empty;
    private int UserDepart = 0;
    private int index1 = 1;
    private bool cargando = false;

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private IProjects repository { get; set; } = null!;
    [Inject] private IDeparments repodepart { get; set; } = null!;
    [Inject] private ICategories repocategoria { get; set; } = null!;
    [Inject] private IEmployee repouser { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            mostrarAlerta = false;
            cargando = true;
            StateHasChanged();
            try
            {
                var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
                if (!string.IsNullOrEmpty(userrolaux.Value))
                {
                    UserRol = int.Parse(userrolaux.Value);
                    var userdepartaux = await SessionStorage.GetAsync<string>("UserDepart");
                    UserDepart = int.Parse(userdepartaux.Value);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
                mensajeAlerta = ex.Message;
                mostrarAlerta = true;
            }

            try
            {
                categorias = (List<Categories>)await repocategoria.GetAllAsync();

                if (UserRol == 1)
                {
                    departamento = (List<Deparments>)await repodepart.GetAllAsync();
                    proyectos = (List<Projects>)await repository.GetAllAsync();
                }
                else
                {
                    int aux = (UserDepart == null ? -1 : int.Parse(UserDepart.ToString()));
                    proyectos = (List<Projects>)await repository.GetByDeparmentIdAsync(aux);
                }
                StateHasChanged();
            }
            catch (Exception ex)
            {
                //Logger.LogError(ex.Message);
                mensajeAlerta = ex.Message;
                mostrarAlerta = true;
            }

            cargando = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UserRol = int.Parse(userrol);
    }

    private int BuscarIndex(int idProject)
    {
        index1 = 1;
        foreach (var proyecto in proyectos)
        {
            if (proyecto.IdProject == idProject)
            {
                return index1;
            }
            index1++;
        }
        return index1;
    }

    private async Task MostrarFormulario()
    {
        try
        {
            proyectoActual = new CreateProject();
            if (UserRol == 1)
                proyectoActual.IdDeparmento = -1;
            else
            {
                int aux = (UserDepart == null ? -1 : int.Parse(UserDepart.ToString()));
                proyectoActual.IdDeparmento = aux;
            }

            proyectoActual.idCategoria = -1;
            proyectoActual.StatusProject = 1;
            proyectoActual.ProjectDate = DateTime.Now;
            proyectoActual.CreatedDate = DateTime.Now;
            proyectoActual.CreatedUser = username;
            proyectoActual.UpdatedDate = DateTime.Now;
            proyectoActual.UpdatedUser = username;

            mostrarFormulario = true;
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task EditarEntidad(Projects proyecto)
    {
        try
        {
            proyectoActual = new CreateProject
            {
                IdProject = proyecto.IdProject,
                ProjectName = proyecto.ProjectName,
                ProjectDate = proyecto.ProjectDate,
                IdDeparmento = proyecto.Deparment.Id,
                idCategoria = proyecto.Categories.Id,
                ProjectDescription = proyecto.ProjectDescription,
                MaxPushes = proyecto.MaxPushes,
                MaxPulls = proyecto.MaxPulls,
                RutaImage = proyecto.RutaImage,
                CreatedDate = proyecto.CreatedDate,
                CreatedUser = proyecto.CreatedUser,
                UpdatedDate = DateTime.Now,
                UpdatedUser = username,
                StatusProject = proyecto.StatusProject
            };
            mostrarFormulario = true;
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task EditarEntidad2(Projects proyecto)
    {
        try
        {
            proyectoActual = new CreateProject
            {
                IdProject = proyecto.IdProject,
                ProjectName = proyecto.ProjectName,
                ProjectDate = proyecto.ProjectDate,
                IdDeparmento = proyecto.Deparment.Id,
                idCategoria = proyecto.Categories.Id,
                ProjectDescription = proyecto.ProjectDescription,
                MaxPushes = proyecto.MaxPushes,
                MaxPulls = proyecto.MaxPulls,
                RutaImage = proyecto.RutaImage,
                CreatedDate = proyecto.CreatedDate,
                CreatedUser = proyecto.CreatedUser,
                UpdatedDate = DateTime.Now,
                UpdatedUser = username,
                StatusProject = 1
            };
            mostrarFormulario2 = true;
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task GuardarEntidad()
    {
        try
        {
            if (proyectoActual.IdProject == 0)
                await repository.CreateAsync(proyectoActual);
            else
                await repository.UpdateAsync(proyectoActual);

            proyectos = (List<Projects>)await repository.GetAllAsync();
            mostrarFormulario = false;
            mensajeAlerta = "Proyecto guardado exitosamente.";
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task EliminarEntidad(int id)
    {
        try
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Esta seguro que desea eliminar este registro?");
            if (confirmed)
            {
                await repository.DeleteAsync(id);
                proyectos = (List<Projects>)await repository.GetAllAsync();
                mensajeAlerta = "Proyecto eliminado exitosamente.";
                mostrarAlerta = true;
                await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = "No se puede eliminar el registros ya que existen relaciones con otras tablas que no han sido eliminadas.";
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
            Logger.LogError(ex.Message);
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mostrarFormulario2 = false;
    }

    private async Task AgrgarEntrvistado(string id)
    {
        try
        {
            NavigationManager.NavigateTo($"proyect/interview/{id}/{UserRol}");
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task AgrgarGrupos(string id)
    {
        try
        {
            NavigationManager.NavigateTo($"proyect/proyecsgroups/{id}/{UserRol}");
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task AgruparHistorias(string id)
    {
        try
        {
            NavigationManager.NavigateTo($"proyect/proyecsagrupar/{id}/{UserRol}");
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task MostrarMatriz(string id)
    {
        try
        {
            NavigationManager.NavigateTo($"proyect/proyecsmatriz/{id}/{UserRol}");
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task ValidarGrupos(string id)
    {
        try
        {
            NavigationManager.NavigateTo($"proyect/proyecsvalidar/{id}/{UserRol}");
        }
        catch (Exception ex)
        {
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }

    private async Task CerrarProyecto()
    {
        try
        {
            await repository.UpdateAsync(proyectoActual);

            mensajeAlerta = "Proyecto re-abierto exitosamente.";
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);

            mostrarFormulario2 = false;

            try
            {
                proyectos = (List<Projects>)await repository.GetAllAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex.Message);
                mensajeAlerta = ex.Message;
                mostrarAlerta = true;
                await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
            mensajeAlerta = ex.Message;
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
    }
}