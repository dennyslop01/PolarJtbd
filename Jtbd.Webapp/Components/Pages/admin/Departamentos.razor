@page "/admin/departamentos/{userrol}"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject IConfiguration configuration
@inject ILogger<Departamentos> Logger
@inject AuthenticationStateProvider authenticationStateProvider

<PageTitle>Departamentos | Sales Clusters</PageTitle>

@if (userrol == "1")
{
    <!-- Enterprise Breadcrumbs -->
    <div class="enterprise-breadcrumbs">
        <a href="@($"proyect/proyectos/{userrol}")" class="breadcrumb-link text-decoration-none">
            <i class="bi bi-folder2-open"></i> Proyectos
        </a>
        <i class="bi bi-chevron-right breadcrumb-separator"></i>
        <span class="breadcrumb-current text-primary">Gestión de Departamentos</span>
    </div>

    @if (mostrarAlerta)
    {
        <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container shadow" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
        </div>
    }

    <div class="card-enterprise">
        <div class="card-enterprise-header flex-wrap gap-3">
            <div>
                <h4 class="card-enterprise-title">
                    <i class="bi bi-building-fill text-primary"></i> Estructura Organizacional / Departamentos
                </h4>
                <span class="text-muted small">Unidades de negocio y áreas funcionales de Empresas Polar</span>
            </div>
            <div>
                <button class="btn boton-primario" title="Agregar Departamento" @onclick="MostrarFormulario">
                    <i class="bi bi-plus-lg"></i> Nuevo Departamento
                </button>
            </div>
        </div>

        @if (departamento is null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Cargando departamentos...</p>
            </div>
        }
        else if (!departamento.Any())
        {
            <div class="text-center py-5 border rounded bg-light">
                <i class="bi bi-building-x text-muted" style="font-size: 2.5rem;"></i>
                <p class="text-muted mt-2 mb-0">No hay departamentos disponibles.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th width="8%">ID</th>
                            <th width="74%">Nombre de Departamento</th>
                            <th width="18%" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (p, index) in departamento.Select((p, i) => (p, i + 1)))
                        {
                            <tr>
                                <td class="text-muted fw-bold">@p.Id</td>
                                <td class="fw-bold text-dark">
                                    <i class="bi bi-building me-2 text-secondary"></i>@p.Name
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn boton-secundario btn-fijo" title="Editar Departamento" @onclick="() => EditarEntidad(p)">
                                            <i class="bi bi-pencil"></i> 
                                        </button>
                                        <button class="btn btn-enterprise-danger btn-fijo" title="Eliminar Departamento" @onclick="() => EliminarEntidad(p.Id)">
                                            <i class="bi bi-trash"></i> 
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (mostrarFormulario)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(departamentoActual.Id == 0 ? "Agregar" : "Editar")</h5>
                        <button type="button" class="btn-close" @onclick="Cancelar"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="departamentoActual" OnValidSubmit="GuardarEntidad">
                            <div class="mb-3">
                                <label class="form-label">Nombre:</label>
                                <InputText class="form-control" @bind-Value="departamentoActual.Name" />
                                <ValidationMessage For="@(() => departamentoActual.Name)" />
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn boton-primario me-2">
                                    <i class="bi bi-save"></i> Guardar
                                </button>
                                <button type="button" class="btn btn-danger" @onclick="Cancelar">
                                    <i class="bi bi-times"></i> Cancelar
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="row align-content-center">
        <div class="col-lg-11">
            <div class="col-lg-11">
                <h3 class="text-center mt-4">No Autorizado</h3>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string userrol { get; set; }

    private List<Deparments> departamento = new();
    private Deparments departamentoActual = new();
    private bool mostrarFormulario = false;
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private IDeparments repository { get; set; } = null!;
    [Inject] private IEmployee repouser { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            mostrarAlerta = false;
        }
    }
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            departamento = (List<Deparments>)await repository.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    private void MostrarFormulario()
    {
        try
        {
            departamentoActual = new Deparments();
            mostrarFormulario = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    private void EditarEntidad(Deparments deparmento)
    {
        try
        {
            departamentoActual = new Deparments
                {
                    Id = deparmento.Id,
                    Name = deparmento.Name,
                };
            mostrarFormulario = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    private async Task GuardarEntidad()
    {
        try
        {
            if (departamentoActual.Id == 0)
                await repository.CreateAsync(departamentoActual);
            else
                await repository.UpdateAsync(departamentoActual);

            departamento = (List<Deparments>)await repository.GetAllAsync();
            mostrarFormulario = false;
            mensajeAlerta = "Deparmento guardad0 exitosamente.";
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message);
        }
    }

    private async Task EliminarEntidad(int id)
    {
        try
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Esta seguro que desea eliminar este registro?");
            if (confirmed)
            {
                await repository.DeleteAsync(id);
                departamento = (List<Deparments>)await repository.GetAllAsync();
                mensajeAlerta = "Deparmento eliminad0 exitosamente.";
                mostrarAlerta = true;
                await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = "No se puede eliminar el registros ya que existen relaciones con otras tablas que no han sido eliminadas.";
            mostrarAlerta = true;
            await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
            Logger.LogError(ex.Message);
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}