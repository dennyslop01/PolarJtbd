@inject AuthenticationStateProvider authenticationStateProvider
@inject NavigationManager NavigationManager
@inject ProtectedSessionStorage SessionStorage
@implements IDisposable

@inherits LayoutComponentBase
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

<MudLayout>
    <MudAppBar Elevation="3" Class="navbar-top">
        <!-- Brand / Identity -->
        <a href="@($"proyect/proyectos/{EffectiveUserRol}")" class="brand-wrapper text-decoration-none">
            <img src="LogoInnova.png" alt="Empresas Polar" class="brand-logo-img" />
            <div class="brand-text-block ms-2 d-none d-sm-flex">
                <span class="brand-title">Sales Clusters</span>
                <span class="brand-subtitle-badge">
                    <i class="bi bi-diagram-3-fill"></i> Segmentación & Clustering Ward
                </span>
            </div>
        </a>

        <!-- Spacer pushes nav items & user to the right -->
        <MudSpacer />

        <div class="d-flex align-items-center gap-2">
            <!-- Menú Principal: Proyectos -->
            <NavLink href="@($"proyect/proyectos/{EffectiveUserRol}")" class="btn nav-enterprise-btn" Match="NavLinkMatch.Prefix">
                <i class="bi bi-folder2-open me-1"></i> Proyectos
            </NavLink>

            @if (EffectiveUserRol == 1)
            {
                <!-- Menú de Administración / Tablas Básicas para Administradores -->
                <NavLink href="@($"admin/categorias/{EffectiveUserRol}")" class="btn nav-enterprise-btn" Match="NavLinkMatch.Prefix" title="Catálogo de Categorías">
                    <i class="bi bi-tags me-1"></i> Categorías
                </NavLink>
                <NavLink href="@($"admin/departamentos/{EffectiveUserRol}")" class="btn nav-enterprise-btn" Match="NavLinkMatch.Prefix" title="Estructura de Departamentos">
                    <i class="bi bi-building me-1"></i> Departamentos
                </NavLink>
                <NavLink href="@($"admin/usuarios/{EffectiveUserRol}")" class="btn nav-enterprise-btn" Match="NavLinkMatch.Prefix" title="Directorio de Usuarios y Roles">
                    <i class="bi bi-people me-1"></i> Usuarios
                </NavLink>
            }

            <div class="user-profile-badge ms-2 d-none d-md-flex">
                <div class="user-avatar-circle">
                    @GetInitials(usernamelargo)
                </div>
                <div class="user-info-text">
                    <span class="user-name-label">@usernamelargo</span>
                    <span class="user-role-label">@GetRoleName(EffectiveUserRol)</span>
                </div>
            </div>
        </div>
    </MudAppBar>
    @* Needed for snackbars *@
    <MudSnackbarProvider />

    <MudMainContent>
        <div class="enterprise-container">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;
    private string username = "dusa-user";
    private string usernamelargo = "dusa-user";
    public int userrol = 0;
    
    // Si userrol no está determinado aún o en modo local, asume 1 (Administrador) para garantizar acceso al menú
    public int EffectiveUserRol => userrol > 0 ? userrol : 1;

    [Inject] private IEmployee repouser { get; set; } = null!;

    private string GetRoleName(int rol) => rol switch
    {
        1 => "Administrador",
        2 => "Analista / Gestor",
        3 => "Visualizador",
        _ => "Administrador"
    };

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "EP";
        var parts = name.Split(new[] { ' ', '.', '\\' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override void OnInitialized()
    {
        UpdateRoleFromUri(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateRoleFromUri(e.Location);
        _ = CheckRoleFromSessionAsync();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckRoleFromSessionAsync();
        }
    }

    private void UpdateRoleFromUri(string uri)
    {
        try
        {
            var uriObj = new Uri(uri);
            var segments = uriObj.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

            if (segments.Any(s => s.Equals("admin", StringComparison.OrdinalIgnoreCase)))
            {
                userrol = 1;
                return;
            }

            if (segments.Length >= 4 && segments.Any(s => s.Equals("proyecsdefinirjob", StringComparison.OrdinalIgnoreCase)))
            {
                var idx = Array.FindIndex(segments, s => s.Equals("proyecsdefinirjob", StringComparison.OrdinalIgnoreCase));
                if (idx >= 0 && segments.Length > idx + 2 && int.TryParse(segments[idx + 2], out int rDef))
                {
                    userrol = rDef;
                    return;
                }
            }

            for (int i = segments.Length - 1; i >= 0; i--)
            {
                if (int.TryParse(segments[i], out int parsed) && parsed >= 1 && parsed <= 5)
                {
                    userrol = parsed;
                    return;
                }
            }
        }
        catch { }
    }

    private async Task CheckRoleFromSessionAsync()
    {
        try
        {
            var rolVal = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(rolVal.Value) && int.TryParse(rolVal.Value, out int sessionRol) && sessionRol > 0)
            {
                userrol = sessionRol;
                var userNameVal = await SessionStorage.GetAsync<string>("UserName");
                if (!string.IsNullOrEmpty(userNameVal.Value))
                {
                    username = userNameVal.Value;
                }
                var largoVal = await SessionStorage.GetAsync<string>("UserNameLargo");
                if (!string.IsNullOrEmpty(largoVal.Value))
                {
                    usernamelargo = largoVal.Value;
                }
                StateHasChanged();
                return;
            }

            var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User?.Identity != null && authState.User.Identity.IsAuthenticated)
            {
                usernamelargo = authState.User.Identity.Name ?? "";
                var splitName = authState.User.Identity.Name?.Split('\\');
                if (splitName != null && splitName.Length > 1)
                {
                    username = splitName[1].Trim();
                }
                else if (splitName != null && splitName.Length == 1 && !string.IsNullOrEmpty(splitName[0]))
                {
                    username = splitName[0].Trim();
                }

                if (!string.IsNullOrEmpty(username))
                {
                    Employee user = await repouser.GetByUsernameAsync(username);
                    if (user != null)
                    {
                        userrol = user.EmployeeRol;
                        usernamelargo = user.EmployeeName;
                        await SessionStorage.SetAsync("UserRol", user.EmployeeRol.ToString());
                        await SessionStorage.SetAsync("UserName", username);
                        await SessionStorage.SetAsync("UserNameLargo", usernamelargo);
                    }
                }
            }
            else
            {
                if (userrol <= 0)
                {
                    userrol = 1;
                }
            }
            StateHasChanged();
        }
        catch { }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

<script language="javascript">
    // Helper para timeouts
    window.TimeoutHelper = {
        showAndHide: function (elementId, timeoutMs) {
            const divElement = document.getElementById(elementId);
            if (divElement) {
                divElement.style.display = 'block';
                setTimeout(function () {
                    divElement.style.display = 'none';
                }, timeoutMs);
            }
        }
    };
</script>
